# Copy this file to `.env` (same directory) and fill in your key.
#
#     cp .env.example .env
#
# `.env` is gitignored — never commit it. The proxy reads it at startup via
# `node --env-file-if-exists=.env`; see `npm start`.
#
# Check it took effect:
#     curl http://127.0.0.1:8787/api/health
# It should report the provider you chose and `"hasKey": true`.
#
# LLM_PROVIDER is optional — it is inferred from whichever key is present.
# Set it explicitly to `mock` to force canned responses.
#   mock | local | nim | openrouter

# --- Local model (llama.cpp or Ollama, no API key needed) ------------------
# The escape hatch from a slow free tier. Both runtimes expose an
# OpenAI-compatible /v1/chat/completions AND support JSON-schema-constrained
# decoding, which is what makes a small (<=2B) model viable — a small model
# cannot be trusted to emit bare JSON from a prompt alone.
#
#   ollama serve                     # then: ollama pull qwen2.5:1.5b-instruct
#   llama-server -m model.gguf --port 8081
#
# LLM_PROVIDER=local
# LOCAL_BASE_URL=http://127.0.0.1:8081/v1
# LOCAL_MODEL=local-model
# LOCAL_INTENT_MODEL=
# LOCAL_TIMEOUT_MS=180000
# LOCAL_INTENT_TIMEOUT_MS=45000

# --- OpenRouter -----------------------------------------------------------
# Free models end in `:free` and are rate-limited. Verify the id still exists
# before relying on it; the catalogue changes.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- NVIDIA NIM -----------------------------------------------------------
# Free development tier. Read the acceptable-use terms before shipping.
# NIM_API_KEY=
# NIM_MODEL=meta/llama-3.1-8b-instruct
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Explicit provider (optional) -----------------------------------------
# LLM_PROVIDER=openrouter

# --- Server ---------------------------------------------------------------
PORT=8787

# Guards against a malicious page POSTing to localhost and spending your key.
# Must match the address you open the page on.
#
# A comma-separated list is allowed, and on a dev box you almost always want more
# than one: `localhost`, `127.0.0.1` and the WSL address are the same machine, but
# the browser sends whichever one you actually typed, and a mismatch is refused
# with a 403 that surfaces in the page as an unreachable proxy. The character
# still moves on a fallback wander, so it looks alive while the model is doing
# nothing at all — check the HUD's `control` line, not the motion.
ALLOWED_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
